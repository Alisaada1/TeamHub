    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "svix": "^1.15.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
